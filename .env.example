# ============================================================================
# 好游快爆「翻滚吧爆米花」每日任务 —— 环境变量模板
# 用法：复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会入库）
#      青龙面板则在「环境变量」里逐个新建同名变量。
#
# 多账号：每个变量都用 @ 分隔，且各变量的顺序与 HYKB_COOKIE 一一对应。
#   例：HYKB_COOKIE=账号1的scookie@账号2的scookie
#       HYKB_SMDEVICEID=账号1的设备号@账号2的设备号
# ============================================================================

# ─────────── 抓包获取（下面 4 个都来自同一次抓包）───────────
# 抓法：电脑装 Reqable/Charles/Fiddler 开 HTTPS 解密 → 手机连代理装信任 CA →
#      打开好游快爆 App 进「翻滚吧爆米花」活动 → 手动点一次「浇水/签到」 →
#      抓包列表按域名 huodong3.3839.com 过滤，打开任意活动 POST 请求查看：

# 【必配】活动登录凭据 = 请求体 Form 里的 scookie（整段复制）
#         形如 4|0|<uid>|<base64昵称>|<device>|… （竖线分隔）
HYKB_COOKIE=

# 【必配】数美设备号 = 请求体 Form 里的 smdeviceid
#         注意：只有「领取类」请求才带它，所以抓包前务必先在 App 里点一次签到/浇水
#         缺它 → 领取接口被判风控 blacklist，领不到奖
HYKB_SMDEVICEID=

# 【必配·防风控】= 请求头 Headers 里的 User-Agent（整行原样复制）
#         须含 Androidkb/<版本>(android;<机型>;…) 这一段，服务端按机型做真机白名单校验
#         这是必设项：不配脚本直接拒绝运行（不内置默认 UA，避免统一 UA 冒充多台设备被判非真机）
HYKB_UA=

# 【可选】设备识别码 = 请求体 Form 里的 device
#         留空时脚本自动取 HYKB_COOKIE 的第 5 段，通常无需单独配
HYKB_DEVICE=

# ─────────── 扫码获取（仅预约任务 mode=9 需要，不用抓包）───────────
# 【可选】网页登录态 = Pauth; Uauth; accesstoken; nickname 四个 cookie 拼成的串
#         获取：在能开浏览器的电脑上运行  python hykb_web_login.tool.py
#              浏览器开 http://127.0.0.1:8899/ → 快爆 App 扫码 → 手机确认登录 →
#              终端打印出可直接粘贴的一整行，复制到这里（有效期约 1 年）
#         不配不影响其它任务，仅「预约任务」会被跳过
HYKB_WEB_COOKIE=

# ── 哈啰出行（hello_signIn.py）──────────────────────────────
# H5 token：App「我的 → 福利中心 / 奖励金」抓任意请求的 token（32 位十六进制）
# 多账号用 @ 分隔，可写 备注#token 便于日志区分；失效表现为 code=103
hl_token=
# 可选开关（不填走默认）
# hl_sign=1          是否签到
# hl_box=1           是否自动开普通宝箱
# hl_box_opens=1     单次运行最多开几个箱
# hl_task=1          是否巡检任务（只读）
# hl_treasure=1      是否打印宝箱状态（只读）
# hl_mall=0          是否打印积分商城（1=打印，永不自动兑换）
# hl_city=028
# hl_adcode=510108

# ── 同程旅行（tclx.py）签到签名参数 ────────────────────────
# 脚本已内置默认值，通常留空即可；仅当客户端大版本更新导致签到签名失败时才需要填写
# tc_salt_req=
# tc_salt_ds=

# ── 滴滴出行（ddcx.py）──────────────────────────────────────
# token：App「我的 → 福利中心」抓任意一条 https://ut.xiaojukeji.com/ut/welfare/... 请求，
#        复制请求体里的 token 字段（约 218 字符，以 = 结尾）
# 多账号用 & 分隔，可写 备注#token 便于日志区分
# 失效表现：福利中心接口 errno=6001「登录信息失效」，脚本会直接提示换 token
DD_TOKENS=
# 可选开关（不填走默认）
# dd_city=17            城市 id（影响券批次，默认 17=成都）
# dd_lat=30.707130422009786
# dd_lng=104.09652654810503
# dd_sign=1             每日签到
# dd_task=1             接任务 + 领任务奖励 + 领阶梯奖励
# dd_task_complex=0     是否也接需真实完单的复杂任务
# dd_max_task=20        单次最多接几个任务
# dd_divide=1           瓜分福利金（报名未来场次 + 领今日奖励）
# dd_legacy=1           会员权益（等级礼券 / 行程意外险 / 周三折上折）
# dd_janitor=1          天天神券（签到 + 抽奖）
# dd_skyfall=0          天降券弹窗直领（dchn 依赖页面上下文，默认关）
# dd_daily_pick=1       每日精选 / 限时抢
# dd_record=1           打印福利金今日获得明细
# dd_proxy=             代理地址（默认直连，不读系统代理）
